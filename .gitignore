# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*
# ...but keep the example file so others know which variables are needed
!.env.example

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map
# ...but the Vue web portal is written in JavaScript, so keep its source
!admin-web/**/*.js

.flutter-plugins
.flutter-plugins-dependencies

# Firebase
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
# Firebase CLI deploy cache
.firebase/

# Release signing — never commit the real keystore or its passwords.
# android/key.properties.example (tracked) shows the expected format.
android/key.properties
*.jks
*.keystore
admin-web.zip

linux/flutter/generated_plugin_registrant.*
linux/flutter/generated_plugins.cmake
macos/Flutter/GeneratedPluginRegistrant.swift
windows/flutter/generated_plugin_registrant.*
windows/flutter/generated_plugins.cmake

# Local App Check demo token (never commit)
app_check.local.json